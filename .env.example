# Konfigurasi Koneksi MariaDB / MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=maulid_app

# Alternatif menggunakan connection string URL tunggal
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/maulid_app

# Lingkungan aplikasi
NODE_ENV=development

# Secret key untuk signing JWT/session token (Wajib diisi string acak & kuat di production)
AUTH_SECRET=rahasia-kunci-enkripsi-aplikasi-panitia-maulid-yang-sangat-kuat-1448h
